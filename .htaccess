RewriteEngine On
RewriteBase /

# Force HTTPS (Let's Encrypt on accounting.learnmaxacademy.ir)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never serve secrets / examples / source dumps from the web root.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(config|identity-config|bookstore-config)(\.example)?\.php$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(md|sql|py|tsx|ts|map|env)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)^(config|identity-config|bookstore-config)(\.example)?\.php$">
    Deny from all
  </FilesMatch>
  <FilesMatch "\.(md|sql|py|tsx|ts|map|env)$">
    Deny from all
  </FilesMatch>
</IfModule>

RewriteRule ^(schema|src)(/|$) - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ /api/api.php?action=$1 [QSA,L]
